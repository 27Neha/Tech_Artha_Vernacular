# TechArtha Mobile — Environment Template
# Copy to apps/mobile/.env.local for machine-specific overrides (gitignored).

# Mode 1 (Default — Recommended for LAN & Mobile Hotspot):
# Automatically detects your computer's current Wi-Fi or Hotspot IP address.
EXPO_PUBLIC_API_URL=auto
EXPO_PUBLIC_API_PORT=3000

# Mode 2 (Specific LAN / Hotspot IP override):
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# Mode 3 (Cross-Network / Remote / Tunnel Mode):
# Note: `expo start --tunnel` only tunnels Metro (port 8081), NOT NestJS (port 3000).
# When testing from a different network or mobile data, expose port 3000 with a tunnel
# (e.g., `ngrok http 3000` or `cloudflared tunnel --url http://localhost:3000`) and set:
# EXPO_PUBLIC_API_URL=https://your-api-tunnel.ngrok-free.app
