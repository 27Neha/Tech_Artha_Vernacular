{
  "expo": {
    "name": "Tech Artha 2.0",
    "slug": "techartha-v2",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow TechArtha to transcribe your speech into text for vernacular chatbot queries.",
        "NSMicrophoneUsageDescription": "Allow TechArtha to use your microphone for voice input."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.techartha.mobile",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow TechArtha to use the microphone for voice input and vernacular financial queries.",
          "speechRecognitionPermission": "Allow TechArtha to transcribe your spoken voice into text."
        }
      ]
    ],
    "scheme": "techartha",
    "sdkVersion": "57.0.0"
  }
}
