# Server Config
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/techartha?schema=public"

# Authentication (JWT)
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Cybrilla Credentials (PRIMARY INVESTMENT INFRASTRUCTURE)
CYBRILLA_ENV=uat
CYBRILLA_BASE_URL=
CYBRILLA_CLIENT_ID=
CYBRILLA_CLIENT_SECRET=
CYBRILLA_API_KEY=
CYBRILLA_SIGNING_KEY=
CYBRILLA_ENCRYPTION_KEY=

# ONDC Credentials
ONDC_ENV=uat
ONDC_SUBSCRIBER_ID=
ONDC_SUBSCRIBER_URL=
ONDC_SIGNING_PRIVATE_KEY=
ONDC_ENCRYPTION_PRIVATE_KEY=

# OTP / WhatsApp
OTP_PROVIDER=mock
WHATSAPP_PROVIDER=
WHATSAPP_API_TOKEN=

# Reference Data (Fallback)
MFAPI_BASE_URL=https://api.mfapi.in

# Zoho CRM (Optional)
ZOHO_CRM_ACCESS_TOKEN=
