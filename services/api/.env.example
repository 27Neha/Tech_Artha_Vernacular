# ==============================================================================
# TechArtha Backend API Environment Configuration
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:password@localhost:5432/techartha?schema=public"

# Authentication & Security (JWT & Hash Secret)
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
OTP_HASH_SECRET=super_secret_otp_hash_key_change_in_production
AUTH_DEV_BYPASS=false

# ==============================================================================
# Messaging & OTP Channels (STRICTLY WHATSAPP & EMAIL — SMS IS REMOVED)
# ==============================================================================

# OTP Channel Provider Mode ('mock' for local development or 'connected' for live)
OTP_PROVIDER=mock

# 1. WhatsApp OTP via Interakt API
INTERAKT_OTP_ENABLED=false
INTERAKT_API_KEY=your_interakt_api_key_here
INTERAKT_SECRET_KEY=your_interakt_api_key_here
INTERAKT_OTP_TEMPLATE_NAME=techartha_signup_otp
INTERAKT_OTP_LANGUAGE=en

# 2. Email OTP via Zoho ZeptoMail API
ZEPTOMAIL_ENABLED=false
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_SEND_MAIL_TOKEN=Zoho-enczapikey_your_token_here
ZEPTOMAIL_FROM_EMAIL=support@techartha.com
ZEPTOMAIL_FROM_NAME=TechArtha

# ==============================================================================
# CRM Integration (Zoho CRM Contacts & Milestones)
# ==============================================================================
PRIMARY_CRM_PROVIDER=zoho
ZOHO_CRM_BASE_URL=https://www.zohoapis.in/crm/v3
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token

# ==============================================================================
# Centralized Feature Flags
# ==============================================================================
# Disabled until production regulatory clearances and Account Aggregator APIs are available
BANK_LINKING_ENABLED=false
EXPENSE_MANAGEMENT_ENABLED=false
CYBRILLA_PRODUCTION_ENABLED=false

# ==============================================================================
# Cybrilla / Fintech Primitives (Investment Infrastructure)
# ==============================================================================
CYBRILLA_ENV=uat
CYBRILLA_BASE_URL=https://s.finprim.com
CYBRILLA_TENANT_ID=techartha
CYBRILLA_CLIENT_ID=
CYBRILLA_CLIENT_SECRET=

CYBRILLA_PREVERIFY_BASE_URL=https://api.sandbox.cybrilla.com
CYBRILLA_PREVERIFY_CLIENT_ID=
CYBRILLA_PREVERIFY_CLIENT_SECRET=
# Public https address of this API. Cybrilla returns investors to
# <PUBLIC_API_URL>/payments/postback and /mandates/postback after paying or
# approving a mandate. Leave empty locally (the app's techartha:// scheme is used).
PUBLIC_API_URL=
# ONDC Credentials
ONDC_ENV=uat
ONDC_SUBSCRIBER_ID=
ONDC_SUBSCRIBER_URL=
ONDC_SIGNING_PRIVATE_KEY=
ONDC_ENCRYPTION_PRIVATE_KEY=

# Mutual Fund Data API
MFAPI_BASE_URL=https://api.mfapi.in

# ==============================================================================
# Admin Support Channels & Inbound Webhooks
# ==============================================================================
COMPANY_WHATSAPP_NUMBER=+918308816023
WHATSAPP_VERIFY_TOKEN=techartha_whatsapp_token
SUPPORT_EMAIL=support@techartha.com
EMAIL_FROM=support@techartha.com
INBOUND_EMAIL_WEBHOOK_SECRET=your_inbound_webhook_secret_here