generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String         @id @default(uuid())
  mobile            String?        @unique
  // Written only after a verified email OTP, so a non-null value IS the verification
  // flag - there is no separate boolean that can drift out of sync with it.
  email             String?        @unique
  preferredLanguage String         @default("en")
  passwordHash      String?
  referralCode      String?
  clientType        String?
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  auditLogs         AuditLog[]
  customBuckets     CustomBucket[]

  consents          Consent[]
  devices           Device[]
  expenses          Expense[]
  FpInvestorProfile FpInvestorProfile?
  FpMandate         FpMandate[]
  FpPayment         FpPayment[]
  goals             Goal[]
  guardian          Guardian?
  guardianConsents  GuardianConsent[]
  kycApplication     KYCApplication?
  kycRecords         KycRecord[]
  learningProgress   LearningProgress[]
  notifications      Notification[]
  onboardingProgress OnboardingProgress?
  portfolio          Portfolio?
  riskAssessments    RiskAssessment[]
  riskProfile        RiskProfile?
  sessions           Session[]
  supportTickets     SupportTicket[]
  profile            UserProfile?
}

model UserProfile {
  id           String    @id @default(uuid())
  userId       String    @unique
  fullName     String?
  dateOfBirth  DateTime?
  pan          String?
  email        String?   @unique
  gender       String?
  age          Int?
  investorType String?
  majorityDate DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id])
}

model Device {
  id           String   @id @default(uuid())
  userId       String
  deviceId     String   @unique
  deviceType   String?
  fcmToken     String?
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  refreshToken String?  @unique
  deviceId     String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  isActive     Boolean  @default(true)
  user         User     @relation(fields: [userId], references: [id])
}

model OtpVerification {
  id         String    @id @default(uuid())
  mobile     String?
  email      String?
  otpHash    String
  expiresAt  DateTime
  attempts   Int       @default(0)
  channel    String    @default("SMS")
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  status     String
}

model Consent {
  id        String         @id @default(uuid())
  userId    String
  type      String
  version   String
  purpose   String
  provider  String?
  status    String
  ipAddress String?
  deviceId  String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id])
  events    ConsentEvent[]
}

model ConsentEvent {
  id        String   @id @default(uuid())
  consentId String
  event     String
  source    String
  details   String?
  createdAt DateTime @default(now())
  consent   Consent  @relation(fields: [consentId], references: [id])
}

model DisclosureVersion {
  id            String   @id @default(uuid())
  disclosureKey String
  version       String
  content       String
  locale        String   @default("en")
  status        String   @default("PUBLISHED")
  effectiveAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([disclosureKey, version, locale])
}

model OnboardingProgress {
  id                String   @id @default(uuid())
  userId            String   @unique
  step              String
  percentage        Int      @default(0)
  completed         Boolean  @default(false)
  lastCompletedStep String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])
}

model Guardian {
  id               String    @id @default(uuid())
  minorUserId      String    @unique
  fullName         String
  mobile           String
  isMobileVerified Boolean   @default(false)
  relationship     String
  dateOfBirth      DateTime?
  pan              String?
  email            String?
  gender           String?
  address          String?
  documentId       String?
  status           String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  minorUser        User      @relation(fields: [minorUserId], references: [id])
}

model KycRecord {
  id                  String     @id @default(uuid())
  userId              String
  provider            String
  providerReferenceId String?    @unique
  status              String
  failureReason       String?
  metadata            String?
  initiatedAt         DateTime   @default(now())
  completedAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  events              KycEvent[]
  user                User       @relation(fields: [userId], references: [id])
}

model KycEvent {
  id          String    @id @default(uuid())
  kycRecordId String
  status      String
  payload     String?
  createdAt   DateTime  @default(now())
  kycRecord   KycRecord @relation(fields: [kycRecordId], references: [id])
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String
  details      String?
  ipAddress    String?
  actorEmail   String?
  actorRole    String?
  resourceType String?
  resourceId   String?
  result       String?  @default("SUCCESS")
  metadata     Json?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id])
}

model WebhookEvent {
  id          String    @id @default(uuid())
  provider    String
  eventId     String    @unique
  eventType   String
  payloadHash String
  status      String
  error       String?
  retryCount  Int       @default(0)
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
}

model RiskProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  score     Int
  category  String
  answers   String
  version   String   @default("2026.08")
  reasons   String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model RiskAssessment {
  id        String   @id @default(uuid())
  userId    String
  version   String
  score     Int
  category  String
  answers   String
  reasons   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Goal {
  id               String   @id @default(uuid())
  userId           String
  name             String
  targetAmount     Float
  timePeriod       Int
  monthlySip       Float
  bucketName       String
  sipDate          Int
  goalType         String   @default("CUSTOM")
  currentSavings   Float    @default(0)
  inflationRate    Float    @default(0)
  returnAssumption Float    @default(0)
  customAdjustments Json?
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id])
}

model Portfolio {
  id            String    @id @default(uuid())
  userId        String    @unique
  totalInvested Float
  currentValue  Float
  totalReturns  Float
  lastSyncedAt  DateTime  @default(now())
  source        String    @default("NOT_CONNECTED")
  status        String    @default("NOT_CONNECTED")
  holdings      Holding[]
  user          User      @relation(fields: [userId], references: [id])
}

model Holding {
  id             String    @id @default(uuid())
  portfolioId    String
  fundName       String
  amountInvested Float
  currentValue   Float
  units          Float
  nav            Float
  returns        Float
  portfolio      Portfolio @relation(fields: [portfolioId], references: [id])
}

model Expense {
  id          String   @id @default(uuid())
  userId      String
  amount      Float
  category    String
  description String?
  occurredAt  DateTime
  source      String   @default("MANUAL")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, occurredAt])
}

model LearningProgress {
  id        String   @id @default(uuid())
  userId    String
  lessonKey String
  completed Boolean  @default(false)
  score     Int?
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, lessonKey])
}

model SupportTicket {
  id                  String               @id @default(uuid())
  referenceId         String?              @unique
  freshdeskTicketId   BigInt?              @unique
  freshdeskContactId  String?
  freshdeskStatus     Int?                 @default(2)
  channel             String               @default("WHATSAPP")
  priority            String               @default("MEDIUM")
  customerPhone       String?
  customerEmail       String?
  customerName        String?
  assignedAgentName   String?
  assignedAgentEmail  String?
  lastCustomerMessage String?
  lastAgentReply      String?
  resolutionNotes     String?
  resolvedAt          DateTime?
  isOverdue           Boolean              @default(false)
  userId              String?
  subject             String
  message             String
  status              String               @default("OPEN")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User?                @relation(fields: [userId], references: [id])
  messages            SupportMessage[]
  auditEvents         SupportAuditEvent[]

  @@index([freshdeskTicketId])
  @@index([customerPhone])
  @@index([status])
}

model SupportMessage {
  id               String        @id @default(uuid())
  ticketId         String
  senderType       String
  senderName       String
  senderEmail      String?
  content          String
  channel          String        @default("WHATSAPP")
  channelMessageId String?
  deliveryStatus   String        @default("SENT")
  isInternal       Boolean       @default(false)
  createdAt        DateTime      @default(now())
  ticket           SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model SupportAuditEvent {
  id        String        @id @default(uuid())
  ticketId  String
  action    String
  actorName String
  actorRole String?
  details   String?
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  channel   String   @default("IN_APP")
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model KYCApplication {
  id                    String             @id @default(uuid())
  userId                String             @unique
  provider              String             @default("CYBRILLA")
  providerTransactionId String?            @unique
  workflowId            String?
  status                String             @default("NOT_STARTED")
  panStatus             String             @default("PENDING")
  documentStatus        String             @default("PENDING")
  faceLivenessStatus    String             @default("PENDING")
  faceMatchStatus       String             @default("PENDING")
  amlStatus             String             @default("PENDING")
  overallStatus         String             @default("PENDING")
  failureReason         String?
  manualReviewRequired  Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  completedAt           DateTime?
  user                  User               @relation(fields: [userId], references: [id])
  events                KYCProviderEvent[]
  verifications         KYCVerification[]
}

model KYCVerification {
  id                        String         @id @default(uuid())
  applicationId             String
  provider                  String
  transactionId             String
  verificationType          String
  status                    String
  providerRequestId         String?
  providerResponseReference String?
  failureReason             String?
  manualReview              Boolean        @default(false)
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  application               KYCApplication @relation(fields: [applicationId], references: [id])
}

model KYCProviderEvent {
  id            String         @id @default(uuid())
  applicationId String
  eventId       String?
  eventType     String
  payload       String
  status        String
  createdAt     DateTime       @default(now())
  application   KYCApplication @relation(fields: [applicationId], references: [id])
}

model FpInvestorProfile {
  id             String                  @id @default(uuid())
  userId         String                  @unique
  fpProfileId    String?                 @unique
  name           String
  pan            String
  dateOfBirth    String
  gender         String
  taxStatus      String                  @default("resident_individual")
  occupation     String
  incomeSlab     String
  sourceOfWealth String
  status         String                  @default("CREATED")
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  user           User                    @relation(fields: [userId], references: [id])
  mfAccounts     FpMfInvestmentAccount[]
}

model FpMfInvestmentAccount {
  id                String            @id @default(uuid())
  fpAccountId       String            @unique
  investorProfileId String
  bankAccountId     String?
  holdingPattern    String            @default("single")
  status            String            @default("ACTIVE")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  investorProfile   FpInvestorProfile @relation(fields: [investorProfileId], references: [id])
  orders            FpPurchaseOrder[]
  plans             FpPurchasePlan[]
}

model FpPurchaseOrder {
  id             String                @id @default(uuid())
  fpOrderId      String?               @unique
  accountId      String
  schemeIsin     String
  amount         Float
  status         String                @default("PENDING")
  folioNumber    String?
  allottedUnits  Float?
  purchasedPrice Float?
  failureReason  String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  account        FpMfInvestmentAccount @relation(fields: [accountId], references: [id])
}

model FpPurchasePlan {
  id             String                @id @default(uuid())
  fpPlanId       String?               @unique
  accountId      String
  bucketId       String
  schemeIsin     String
  amount         Float
  frequency      String                @default("MONTHLY")
  installmentDay Int
  status         String                @default("CREATED")
  mandateId      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  account        FpMfInvestmentAccount @relation(fields: [accountId], references: [id])
}

model CustomBucket {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String   @default("My Custom Bucket")
  funds     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model FpMandate {
  id            String   @id @default(uuid())
  fpMandateId   String?  @unique
  userId        String
  type          String   @default("UPI_AUTOPAY")
  status        String   @default("CREATED")
  maxAmount     Float
  bankAccountId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
}

model FpPayment {
  id             String    @id @default(uuid())
  fpPaymentId    String?   @unique
  orderId        String?
  userId         String
  amount         Float
  currency       String    @default("INR")
  method         String?   // UPI | NETBANKING
  status         String    @default("PENDING") // PENDING | SUCCESSFUL | FAILED | REJECTED
  unitsAllotted  Boolean   @default(false)
  allottedUnits  Float?
  nav            Float?
  allottedAt     DateTime?
  failureReason  String?
  rawResponse    Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model GuardianConsent {
  id                 String    @id @default(uuid())
  minorUserId        String
  guardianId         String
  consentVersion     String
  consentTextHash    String?
  status             String    @default("PENDING")
  ipAddress          String?
  verificationMethod String?
  verifiedAt         DateTime?
  createdAt          DateTime  @default(now())
  minorUser          User      @relation(fields: [minorUserId], references: [id])
}

model TechnicalAgent {
  id                 String   @id @default(uuid())
  fullName           String
  email              String   @unique
  phone              String?
  role               String   @default("TECHNICAL_SUPPORT")
  department         String   @default("Technical Support")
  isActive           Boolean  @default(true)
  notifyOnTickets    Boolean  @default(true)
  notificationEmail  String?
  notificationPhone  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AdminUser {
  id           String            @id @default(uuid())
  email        String            @unique
  name         String
  passwordHash String?
  role         String            @default("OPERATIONS")
  roleId       String?
  department   String            @default("Operations")
  status       String            @default("ACTIVE")
  isActive     Boolean           @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  assignedRole AdminRole?        @relation(fields: [roleId], references: [id])
  invitationsSent AdminInvitation[] @relation("InvitedByAdmin")

  @@index([email])
  @@index([role])
}

model AdminRole {
  id          String                @id @default(uuid())
  name        String                @unique
  displayName String
  description String?
  department  String?
  isSystem    Boolean               @default(false)
  status      String                @default("ACTIVE")
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  permissions AdminRolePermission[]
  users       AdminUser[]
  invitations AdminInvitation[]
}

model AdminPermission {
  id          String                @id @default(uuid())
  slug        String                @unique
  module      String
  action      String
  description String?
  createdAt   DateTime              @default(now())
  roles       AdminRolePermission[]

  @@index([module])
}

model AdminRolePermission {
  id           String          @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime        @default(now())
  role         AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model AdminInvitation {
  id              String     @id @default(uuid())
  invitedEmail    String
  invitedName     String
  tokenHash       String     @unique
  role            String     @default("SUPPORT")
  roleId          String?
  department      String?    @default("Support")
  status          String     @default("INVITED")
  message         String?
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  roleModel       AdminRole? @relation(fields: [roleId], references: [id])
  invitedByUser   AdminUser? @relation("InvitedByAdmin", fields: [invitedByUserId], references: [id])

  @@index([invitedEmail])
  @@index([tokenHash])
  @@index([status])
}

model SystemSetting {
  id          String   @id @default(uuid())
  category    String
  key         String   @unique
  value       Json
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model AdminMember {
  id                  String    @id @default(uuid())
  email               String?   @unique
  name                String?
  role                String?
  phone               String?
  position            String?
  department          String?
  status              String?   @default("ACTIVE")
  invitationToken     String?   @unique
  passwordHash        String?
  permissions         Json?
  failedLoginAttempts Int?      @default(0)
  sessionVersion      Int?      @default(1)
  lastLoginAt         DateTime?
  lastLoginIp         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}
