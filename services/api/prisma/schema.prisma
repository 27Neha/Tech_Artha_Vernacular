generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                @id @default(uuid())
  mobile             String                @unique
  preferredLanguage  String                @default("en")
  passwordHash       String?
  referralCode       String?
  clientType         String?
  isActive           Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  auditLogs          AuditLog[]
  customBuckets      CustomBucket[]
  bseClient          BseClient?
  consents           Consent[]
  devices            Device[]
  expenses           Expense[]
  FpInvestorProfile  FpInvestorProfile?
  FpMandate          FpMandate[]
  goals              Goal[]
  guardian           Guardian?
  guardianConsents   GuardianConsent[]
  minorAssessments   MinorRiskAssessment[]
  kycApplication     KYCApplication?
  kycRecords         KycRecord[]
  learningProgress   LearningProgress[]
  notifications      Notification[]
  onboardingProgress OnboardingProgress?
  portfolio          Portfolio?
  riskAssessments    RiskAssessment[]
  riskProfile        RiskProfile?
  sessions           Session[]
  supportTickets     SupportTicket[]
  profile            UserProfile?
  minorProfileResult MinorInvestorProfileResult?
}

model UserProfile {
  id           String    @id @default(uuid())
  userId       String    @unique
  fullName     String?
  dateOfBirth  DateTime?
  pan          String?
  email        String?   @unique
  gender       String?
  age          Int?
  investorType String?
  majorityDate DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id])
}

model Device {
  id           String   @id @default(uuid())
  userId       String
  deviceId     String   @unique
  deviceType   String?
  fcmToken     String?
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  refreshToken String?  @unique
  deviceId     String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  isActive     Boolean  @default(true)
  user         User     @relation(fields: [userId], references: [id])
}

model OtpVerification {
  id         String    @id @default(uuid())
  mobile     String
  otpHash    String
  expiresAt  DateTime
  attempts   Int       @default(0)
  channel    String    @default("SMS")
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  status     String
}

model Consent {
  id        String         @id @default(uuid())
  userId    String
  type      String
  version   String
  purpose   String
  provider  String?
  status    String
  ipAddress String?
  deviceId  String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id])
  events    ConsentEvent[]
}

model ConsentEvent {
  id        String   @id @default(uuid())
  consentId String
  event     String
  source    String
  details   String?
  createdAt DateTime @default(now())
  consent   Consent  @relation(fields: [consentId], references: [id])
}

model DisclosureVersion {
  id            String   @id @default(uuid())
  disclosureKey String
  version       String
  content       String
  locale        String   @default("en")
  status        String   @default("PUBLISHED")
  effectiveAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([disclosureKey, version, locale])
}

model OnboardingProgress {
  id                String   @id @default(uuid())
  userId            String   @unique
  step              String
  percentage        Int      @default(0)
  completed         Boolean  @default(false)
  lastCompletedStep String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])
}

model Guardian {
  id               String    @id @default(uuid())
  minorUserId      String    @unique
  fullName         String
  mobile           String
  isMobileVerified Boolean   @default(false)
  relationship     String
  dateOfBirth      DateTime?
  pan              String?
  email            String?
  gender           String?
  address          String?
  documentId       String?
  status           String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  minorUser        User      @relation(fields: [minorUserId], references: [id])
}

model KycRecord {
  id                  String     @id @default(uuid())
  userId              String
  provider            String
  providerReferenceId String?    @unique
  status              String
  failureReason       String?
  metadata            String?
  initiatedAt         DateTime   @default(now())
  completedAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  events              KycEvent[]
  user                User       @relation(fields: [userId], references: [id])
}

model KycEvent {
  id          String    @id @default(uuid())
  kycRecordId String
  status      String
  payload     String?
  createdAt   DateTime  @default(now())
  kycRecord   KycRecord @relation(fields: [kycRecordId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model WebhookEvent {
  id          String    @id @default(uuid())
  provider    String
  eventId     String    @unique
  eventType   String
  payloadHash String
  status      String
  error       String?
  retryCount  Int       @default(0)
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
}

model RiskProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  score     Int
  category  String
  answers   String
  version   String   @default("2026.08")
  reasons   String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model RiskAssessment {
  id        String   @id @default(uuid())
  userId    String
  version   String
  score     Int
  category  String
  answers   String
  reasons   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Goal {
  id               String   @id @default(uuid())
  userId           String
  name             String
  targetAmount     Float
  timePeriod       Int
  monthlySip       Float
  bucketName       String
  sipDate          Int
  goalType         String   @default("CUSTOM")
  currentSavings   Float    @default(0)
  inflationRate    Float    @default(0)
  returnAssumption Float    @default(0)
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id])
}

model Portfolio {
  id            String    @id @default(uuid())
  userId        String    @unique
  totalInvested Float
  currentValue  Float
  totalReturns  Float
  lastSyncedAt  DateTime  @default(now())
  source        String    @default("NOT_CONNECTED")
  status        String    @default("NOT_CONNECTED")
  holdings      Holding[]
  user          User      @relation(fields: [userId], references: [id])
}

model Holding {
  id             String    @id @default(uuid())
  portfolioId    String
  fundName       String
  amountInvested Float
  currentValue   Float
  units          Float
  nav            Float
  returns        Float
  portfolio      Portfolio @relation(fields: [portfolioId], references: [id])
}

model Expense {
  id          String   @id @default(uuid())
  userId      String
  amount      Float
  category    String
  description String?
  occurredAt  DateTime
  source      String   @default("MANUAL")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, occurredAt])
}

model LearningProgress {
  id        String   @id @default(uuid())
  userId    String
  lessonKey String
  completed Boolean  @default(false)
  score     Int?
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, lessonKey])
}

model SupportTicket {
  id        String   @id @default(uuid())
  userId    String
  subject   String
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  channel   String   @default("IN_APP")
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model KYCApplication {
  id                    String             @id @default(uuid())
  userId                String             @unique
  provider              String             @default("HYPERVERGE")
  providerTransactionId String?            @unique
  workflowId            String?
  status                String             @default("NOT_STARTED")
  panStatus             String             @default("PENDING")
  documentStatus        String             @default("PENDING")
  faceLivenessStatus    String             @default("PENDING")
  faceMatchStatus       String             @default("PENDING")
  amlStatus             String             @default("PENDING")
  overallStatus         String             @default("PENDING")
  failureReason         String?
  manualReviewRequired  Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  completedAt           DateTime?
  user                  User               @relation(fields: [userId], references: [id])
  events                KYCProviderEvent[]
  verifications         KYCVerification[]
}

model KYCVerification {
  id                        String         @id @default(uuid())
  applicationId             String
  provider                  String
  transactionId             String
  verificationType          String
  status                    String
  providerRequestId         String?
  providerResponseReference String?
  failureReason             String?
  manualReview              Boolean        @default(false)
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  application               KYCApplication @relation(fields: [applicationId], references: [id])
}

model KYCProviderEvent {
  id            String         @id @default(uuid())
  applicationId String
  eventId       String?
  eventType     String
  payload       String
  status        String
  createdAt     DateTime       @default(now())
  application   KYCApplication @relation(fields: [applicationId], references: [id])
}

model BseClient {
  id         String   @id @default(uuid())
  userId     String   @unique
  clientCode String   @unique
  status     String   @default("PENDING")
  bseRemarks String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])
}

model FpInvestorProfile {
  id             String                  @id @default(uuid())
  userId         String                  @unique
  fpProfileId    String?                 @unique
  name           String
  pan            String
  dateOfBirth    String
  gender         String
  taxStatus      String                  @default("resident_individual")
  occupation     String
  incomeSlab     String
  sourceOfWealth String
  status         String                  @default("CREATED")
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  user           User                    @relation(fields: [userId], references: [id])
  mfAccounts     FpMfInvestmentAccount[]
}

model FpMfInvestmentAccount {
  id                String            @id @default(uuid())
  fpAccountId       String            @unique
  investorProfileId String
  bankAccountId     String?
  holdingPattern    String            @default("single")
  status            String            @default("ACTIVE")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  investorProfile   FpInvestorProfile @relation(fields: [investorProfileId], references: [id])
  orders            FpPurchaseOrder[]
  plans             FpPurchasePlan[]
}

model FpPurchaseOrder {
  id             String                @id @default(uuid())
  fpOrderId      String?               @unique
  accountId      String
  schemeIsin     String
  amount         Float
  status         String                @default("PENDING")
  folioNumber    String?
  allottedUnits  Float?
  purchasedPrice Float?
  failureReason  String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  account        FpMfInvestmentAccount @relation(fields: [accountId], references: [id])
}

model FpPurchasePlan {
  id             String                @id @default(uuid())
  fpPlanId       String?               @unique
  accountId      String
  bucketId       String
  schemeIsin     String
  amount         Float
  frequency      String                @default("MONTHLY")
  installmentDay Int
  status         String                @default("CREATED")
  mandateId      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  account        FpMfInvestmentAccount @relation(fields: [accountId], references: [id])
}

model CustomBucket {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String   @default("My Custom Bucket")
  funds     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model FpMandate {
  id            String   @id @default(uuid())
  fpMandateId   String?  @unique
  userId        String
  type          String   @default("UPI_AUTOPAY")
  status        String   @default("CREATED")
  maxAmount     Float
  bankAccountId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
}

model GuardianConsent {
  id                 String    @id @default(uuid())
  minorUserId        String
  guardianId         String
  consentVersion     String
  consentTextHash    String?
  status             String    @default("PENDING")
  ipAddress          String?
  verificationMethod String?
  verifiedAt         DateTime?
  createdAt          DateTime  @default(now())
  minorUser          User      @relation(fields: [minorUserId], references: [id])
}

model MinorRiskAssessment {
  id             String   @id @default(uuid())
  userId         String
  assessmentType String   @default("MINOR_INVESTOR_PROFILE")
  version        String
  answers        String
  score          Int
  profileType    String
  riskCategory   String?
  goal           String?
  timeHorizon    String?
  knowledgeLevel String?
  riskComfort    String?
  completedAt    DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])
}

model MinorInvestorProfileResult {
  id                  String   @id @default(uuid())
  userId              String   @unique
  assessmentId        String?
  assessmentVersion   String   @default("minor-v1")
  
  riskToleranceScore  Int
  timeHorizonScore    Int
  knowledgeScore      Int
  financialHabitScore Int
  
  goalType            String
  profileType         String
  profileTitle        String
  profileTagline      String
  profileConsistency  String
  
  strengths           Json     @default("[]")
  focusAreas          Json     @default("[]")
  nextSteps           Json     @default("[]")
  
  calculatedAt        DateTime @default(now())
  
  user                User     @relation(fields: [userId], references: [id])
}
