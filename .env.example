# Server Config
PORT=3000
NODE_ENV=development

# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/techartha?schema=public"

# Redis Config (Future use)
# REDIS_URL=redis://localhost:6379

# Authentication (JWT)
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# KYC Provider Selection (mock | hyperverge)
KYC_PROVIDER=mock

# HyperVerge Credentials (only required if KYC_PROVIDER=hyperverge)
HYPERVERGE_API_KEY=
HYPERVERGE_APP_ID=
HYPERVERGE_APP_KEY=
HYPERVERGE_BASE_URL=https://ind.idv.hyperverge.co/v1

# AWS (Future use for Document Wallet)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
