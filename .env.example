# Copy to .env. Never commit real credentials. Values below are intentionally empty.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3001
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Development uses SQLite through services/api/prisma/schema.prisma. Set DATABASE_URL
# only after the Prisma provider is deliberately migrated to PostgreSQL.
DATABASE_URL="file:./prisma/dev.db"
REDIS_URL=

# Authentication — use a long, random secret in every deployed environment.
JWT_SECRET=
JWT_EXPIRES_IN=15m
OTP_HASH_SECRET=
OTP_PROVIDER=mock
EXPOSE_MOCK_OTP=false

# Provider modes must be explicit. Mock never means production connectivity.
KYC_PROVIDER=mock
HYPERVERGE_ENABLED=false
HYPERVERGE_APP_ID=
HYPERVERGE_APP_KEY=
HYPERVERGE_API_KEY=
HYPERVERGE_WORKFLOW_ID=

# Exact values and endpoint paths must be copied from each approved provider's docs.
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=
DIGIO_BASE_URL=
CAMS_BASE_URL=
CAMS_CLIENT_ID=
CAMS_CLIENT_SECRET=
KFINTECH_BASE_URL=
KFINTECH_CLIENT_ID=
KFINTECH_CLIENT_SECRET=
BSE_BASE_URL=
BSE_CLIENT_ID=
BSE_CLIENT_SECRET=
NSE_BASE_URL=
NSE_CLIENT_ID=
NSE_CLIENT_SECRET=
FINTECH_PRIMITIVES_BASE_URL=
FINTECH_PRIMITIVES_CLIENT_ID=
FINTECH_PRIMITIVES_CLIENT_SECRET=
ONTC_BASE_URL=
ONTC_CLIENT_ID=
ONTC_CLIENT_SECRET=

# Public MFAPI is supplemental only: never use it for orders or reconciliation.
MFAPI_BASE_URL=https://api.mfapi.in

# Zoho must use server-side OAuth with least-privilege scopes.
ZOHO_CRM_BASE_URL=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=
ZOHO_REFRESH_TOKEN=
ZOHO_FORMS_BASE_URL=

# Communication and AI/voice provider settings.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
SMS_PROVIDER=
SMS_API_KEY=
EMAIL_PROVIDER=
EMAIL_API_KEY=
SARVAM_API_KEY=
AI_PROVIDER=
AI_API_KEY=

# Object storage and observability.
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SENTRY_DSN=
