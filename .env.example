# ==========================================
# TECHARTHA - ENVIRONMENT VARIABLES
# ==========================================

# 1. CORE SYSTEM
NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/techartha?schema=public"
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
OTP_HASH_SECRET=super_secret_otp_hash_key_change_in_production
FRONTEND_URL=http://localhost:3000

# 2. MESSAGING & OTP CHANNELS (STRICTLY WHATSAPP & EMAIL — SMS REMOVED)
OTP_PROVIDER=mock
INTERAKT_OTP_ENABLED=false
INTERAKT_API_KEY=
INTERAKT_SECRET_KEY=
INTERAKT_OTP_TEMPLATE_NAME=techartha_signup_otp
INTERAKT_OTP_LANGUAGE=en

ZEPTOMAIL_ENABLED=false
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_SEND_MAIL_TOKEN=
ZEPTOMAIL_FROM_EMAIL=support@techartha.com
ZEPTOMAIL_FROM_NAME=TechArtha

# 3. CRM (ZOHO)
PRIMARY_CRM_PROVIDER=zoho
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_CRM_BASE_URL=https://www.zohoapis.in/crm/v3
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in

# 4. FEATURE FLAGS (BANK LINKING & EXPENSES DISABLED UNTIL PRODUCTION)
BANK_LINKING_ENABLED=false
EXPENSE_MANAGEMENT_ENABLED=false
CYBRILLA_PRODUCTION_ENABLED=false

# 5. INVESTMENT TRANSACTIONS (CYBRILLA / FINPRIM)
CYBRILLA_ENV=uat
CYBRILLA_BASE_URL=https://s.finprim.com
CYBRILLA_TENANT_ID=techartha
CYBRILLA_CLIENT_ID=
CYBRILLA_CLIENT_SECRET=
CYBRILLA_PREVERIFY_BASE_URL=https://api.sandbox.cybrilla.com
CYBRILLA_PREVERIFY_CLIENT_ID=
CYBRILLA_PREVERIFY_CLIENT_SECRET=

# 6. MUTUAL FUND & NAV (MFAPI)
MFAPI_BASE_URL=https://api.mfapi.in
