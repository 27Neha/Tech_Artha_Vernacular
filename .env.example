# ==========================================
# TECHARTHA - PRODUCTION ENVIRONMENT VARIABLES
# ==========================================

# 1. CORE SYSTEM
NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/techartha?schema=public"
JWT_SECRET=
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# 2. KYC (HYPERVERGE / DIGIO)
PRIMARY_KYC_PROVIDER=hyperverge
HYPERVERGE_API_KEY=
HYPERVERGE_APP_ID=
HYPERVERGE_BASE_URL=
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=
DIGIO_BASE_URL=

# 3. MUTUAL FUND & NAV (CAMS / KFINTECH / MFAPI)
NAV_REFERENCE_PROVIDER=mfapi
MFAPI_BASE_URL=https://api.mfapi.in/mf
CAMSKFIN_API_KEY=
CAMSKFIN_CLIENT_ID=
CAMSKFIN_CLIENT_SECRET=
CAMSKFIN_BASE_URL=

# 4. INVESTMENT TRANSACTIONS (BSE / NSE)
PRIMARY_MF_TRANSACTION_PROVIDER=bse
BSE_API_KEY=
BSE_CLIENT_ID=
BSE_CLIENT_SECRET=
BSE_BASE_URL=
NSE_API_KEY=
NSE_CLIENT_ID=
NSE_CLIENT_SECRET=
NSE_BASE_URL=

# 5. CRM (ZOHO)
PRIMARY_CRM_PROVIDER=zoho
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_API_DOMAIN=

# 6. PROVIDER ENVIRONMENTS
# Must be either SANDBOX or PRODUCTION
PROVIDER_ENVIRONMENT=SANDBOX
