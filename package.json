{
  "name": "techartha",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "mobile": "npm run start --workspace=mobile",
    "mobile:lan": "npm run start:lan --workspace=mobile",
    "mobile:tunnel": "npm run start:tunnel --workspace=mobile",
    "mobile:localhost": "npm run start:localhost --workspace=mobile",
    "web": "npm run dev --workspace=web",
    "admin": "npm run dev --workspace=admin",
    "api": "npm run start:dev --workspace=api",
    "db:migrate": "npm run db:migrate --workspace=api",
    "db:seed": "npm run db:seed --workspace=api",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces"
  }
}
